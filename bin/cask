#!/usr/bin/env python3
# cask - Standalone Homebrew-free macOS GUI app & CLI formula installer for Intel Macs.
import sys, urllib.request, json, os, re, glob, shutil, subprocess, tempfile, plistlib

CLI_USER_AGENT = "intel-cask/1.0 (Macintosh; Intel Mac OS X; x86_64) curl/8.0"

INTEL_OS_KEYS = [
    "golden_gate", "tahoe", "sequoia", "sonoma", "ventura",
    "monterey", "big_sur", "catalina", "mojave", "high_sierra",
    "x86_64", "all"
]

EXCLUDED_ASSET_EXTS = (
    ".sha256", ".sha512", ".sig", ".asc", ".sbom", ".blockmap",
    ".yml", ".yaml", ".json", ".txt", ".deb", ".rpm", ".appimage",
    ".exe", ".msi", ".apk", ".zst", ".msix", ".nupkg"
)

EXCLUDED_BIN_DIRS = {
    "share", "man", "doc", "docs", "completions", "completion",
    "include", "etc", "lib", "pkgconfig", "zsh", "bash", "fish"
}

EXCLUDED_BIN_EXTS = (
    ".dylib", ".so", ".a", ".o", ".plist", ".md", ".txt", ".json",
    ".rb", ".1", ".2", ".3", ".4", ".5", ".6", ".7", ".8",
    ".bash", ".zsh", ".fish", ".ps1", ".html", ".css", ".png", ".svg"
)

def run_cmd(cmd, **kwargs):
    if cmd and cmd[0] == "sudo":
        try:
            with open("/dev/tty", "rb") as tty:
                return subprocess.run(cmd, stdin=tty, **kwargs)
        except Exception:
            return subprocess.run(cmd, **kwargs)
    return subprocess.run(cmd, **kwargs)

def to_list(val):
    if isinstance(val, list):
        return val
    return [val] if val else []

def parse_local_rb(rb_path):
    with open(rb_path, "r") as f:
        raw_content = f.read()

    content = re.sub(r'livecheck\s+do\b.*?\bend\b', '', raw_content, flags=re.DOTALL)
    token_m = re.search(r'(?:cask|formula)\s+["\x27]([^"\x27]+)["\x27]', content)
    token = token_m.group(1) if token_m else os.path.basename(rb_path).replace(".rb", "")

    arch_m = re.search(r'arch\s+.*?intel:\s*["\x27]([^"\x27]+)["\x27]', content)
    intel_arch = arch_m.group(1) if arch_m else "x86_64"

    intel_block = re.search(r'on_intel\s+do(.*?)end', content, re.DOTALL)
    sub = intel_block.group(1) if intel_block else content

    ver_m = re.search(r'version\s+["\x27]([^"\x27]+)["\x27]', sub) or re.search(r'version\s+["\x27]([^"\x27]+)["\x27]', content)
    version = ver_m.group(1) if ver_m else ""
    parts = version.split(",")

    url_m = re.search(r'url\s+["\x27]([^"\x27]+)["\x27]', sub) or re.search(r'url\s+["\x27]([^"\x27]+)["\x27]', content)
    if not url_m:
        return None
    url = url_m.group(1)
    url = url.replace("#{version.csv.first}", parts[0] if parts else "")
    if len(parts) > 1:
        url = url.replace("#{version.csv.second}", parts[1])
    if len(parts) > 2:
        url = url.replace("#{version.csv.third}", parts[2])
    url = url.replace("#{version}", version)
    url = re.sub(r'#\{arch\}', intel_arch, url)

    apps = re.findall(r'\bapp\s+["\x27]([^"\x27]+)["\x27]', content)
    pkgs = re.findall(r'\bpkg\s+["\x27]([^"\x27]+)["\x27]', content)
    bins = re.findall(r'\bbinary\s+["\x27]([^"\x27]+)["\x27](?:\s*,\s*target:\s*["\x27]([^"\x27]+)["\x27])?', content)
    artifacts = []
    if apps:
        artifacts.append({"app": apps})
    if pkgs:
        artifacts.append({"pkg": pkgs})
    for src_bin, target_bin in bins:
        src_bin = src_bin.replace("#{appdir}", "$APPDIR").replace("#{staged_path}", f"/usr/local/Caskroom/{token}")
        if target_bin:
            artifacts.append({"binary": [src_bin, {"target": target_bin}]})
        else:
            artifacts.append({"binary": [src_bin]})
    return {"token": token, "version": version, "url": url, "artifacts": artifacts, "variations": {}, "depends_on": {}}

def get_github_release_assets(owner, repo, tags=None):
    """
    Fetches release assets for a GitHub repository.
    Uses GitHub's expanded_assets HTML endpoint first to avoid API rate limits,
    falling back to api.github.com if needed.
    """
    candidate_tags = [t for t in dict.fromkeys(tags or []) if t]

    def fetch_expanded(tag):
        url = f"https://github.com/{owner}/{repo}/releases/expanded_assets/{tag}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=12) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        links = re.findall(r'href=["\x27](/[^"\x27]+/releases/download/[^"\x27]+)["\x27]', html)
        if links:
            assets = [
                {"name": urllib.request.unquote(l.split("/")[-1]), "browser_download_url": "https://github.com" + l}
                for l in dict.fromkeys(links)
            ]
            return tag, assets
        return None, []

    for tag in candidate_tags:
        try:
            found_tag, assets = fetch_expanded(tag)
            if assets:
                return found_tag, assets
        except Exception:
            pass

    # Resolve /releases/latest redirect to discover latest tag without API rate limits
    try:
        latest_url = f"https://github.com/{owner}/{repo}/releases/latest"
        req = urllib.request.Request(latest_url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=12) as resp:
            final_url = resp.geturl()
        m = re.search(r"/releases/tag/([^/?#]+)", final_url)
        if m:
            latest_tag = urllib.request.unquote(m.group(1))
            if latest_tag not in candidate_tags:
                found_tag, assets = fetch_expanded(latest_tag)
                if assets:
                    return found_tag, assets
    except Exception:
        pass

    # Fallback to GitHub REST API
    headers = {"User-Agent": CLI_USER_AGENT}
    gh_token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if gh_token:
        headers["Authorization"] = f"Bearer {gh_token}"

    api_urls = [f"https://api.github.com/repos/{owner}/{repo}/releases/tags/{t}" for t in candidate_tags]
    api_urls.append(f"https://api.github.com/repos/{owner}/{repo}/releases/latest")
    for api_url in api_urls:
        try:
            req = urllib.request.Request(api_url, headers=headers)
            with urllib.request.urlopen(req, timeout=12) as resp:
                rel = json.loads(resp.read().decode())
            assets = rel.get("assets", [])
            if assets:
                return rel.get("tag_name", "latest"), assets
        except Exception:
            pass

    return None, []

def pick_intel_mac_asset(assets, token="", prefer_cli=False):
    candidates = []
    for asset in assets:
        name = asset.get("name", "")
        dl_url = asset.get("browser_download_url", "")
        lower = name.lower()
        if not name or not dl_url:
            continue
        if lower.endswith(EXCLUDED_ASSET_EXTS):
            continue
        if re.search(r"(linux|windows|win32|win64|freebsd|openbsd|netbsd|android|ios|msvc|gnu|musl)", lower):
            continue
        if re.search(r"(arm64|aarch64|armv|apple[-_]?silicon)", lower):
            continue

        is_mac_named = bool(re.search(r"(darwin|macos|mac|osx|apple)", lower)) or lower.endswith((".dmg", ".pkg", ".mpkg"))
        if not is_mac_named:
            continue

        score = 0
        if re.search(r"(x86_64|x64|amd64|intel)", lower):
            score += 50
        elif re.search(r"(universal|all|any)", lower):
            score += 40
        else:
            score += 10

        if prefer_cli:
            if "desktop" in lower or lower.endswith((".dmg", ".app.tar.gz", ".app.zip")):
                score -= 100
            if lower.endswith((".zip", ".tar.gz", ".tgz", ".tar.xz", ".txz", ".tar.bz2", ".tbz2")):
                score += 15
            elif lower.endswith(".pkg"):
                score += 5
        else:
            if lower.endswith(".dmg"):
                score += 20
            elif lower.endswith((".pkg", ".mpkg", ".zip", ".app.tar.gz")):
                score += 15

        if re.search(r"(baseline|profile|debug|symbols|rosetta)", lower):
            score -= 20
        if token and token.lower() in lower:
            score += 5

        candidates.append((score, name, dl_url))

    candidates.sort(key=lambda x: x[0], reverse=True)
    if candidates and candidates[0][0] > 0:
        return candidates[0][2]
    return None

def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": CLI_USER_AGENT})
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None

def get_formula_data(formula_name):
    data = fetch_json(f"https://formulae.brew.sh/api/formula/{formula_name}.json")
    if not data:
        return None

    token = data.get("name", formula_name)
    version = data.get("versions", {}).get("stable", "latest")
    stable_url = data.get("urls", {}).get("stable", {}).get("url", "")
    homepage = data.get("homepage", "")
    dl_url = None

    # 1. Check GitHub Releases for a prebuilt Intel macOS binary/archive
    gh_match = re.search(r"github\.com/([^/]+)/([^/#?]+)", stable_url) or re.search(r"github\.com/([^/]+)/([^/#?]+)", homepage)
    if gh_match:
        owner = gh_match.group(1)
        repo = re.sub(r"\.git$", "", gh_match.group(2))
        tags_to_try = []
        tag_m = re.search(r"refs/tags/([^/]+?)(?:\.tar\.[a-z0-9]+|\.tgz|\.zip)$", stable_url) or re.search(r"releases/download/([^/]+)/", stable_url)
        if tag_m:
            tags_to_try.append(tag_m.group(1))
        if version:
            tags_to_try.extend([f"v{version}", version, f"{token}-{version}", f"{token}-v{version}"])

        _, assets = get_github_release_assets(owner, repo, tags_to_try)
        if assets:
            dl_url = pick_intel_mac_asset(assets, token=token, prefer_cli=True)

    # 2. Fallback to Homebrew Intel macOS bottle if available on ghcr.io
    is_bottle = False
    if not dl_url:
        bottle_files = data.get("bottle", {}).get("stable", {}).get("files", {})
        for os_key in INTEL_OS_KEYS:
            if os_key in bottle_files and "url" in bottle_files[os_key]:
                dl_url = bottle_files[os_key]["url"]
                is_bottle = True
                break
        if not dl_url:
            for k, v in bottle_files.items():
                if not k.startswith("arm64") and "linux" not in k and isinstance(v, dict) and "url" in v:
                    dl_url = v["url"]
                    is_bottle = True
                    break

    if not dl_url:
        return None

    return {
        "token": token,
        "name": [data.get("full_name", token)],
        "desc": data.get("desc", ""),
        "homepage": homepage,
        "version": version,
        "url": dl_url,
        "artifacts": [{"binary": [token]}],
        "variations": {},
        "depends_on": {},
        "_is_formula": True,
        "_is_bottle": is_bottle,
    }

def get_cask_data(cask, prefer_cask=False, prefer_formula=False):
    expanded_rb = os.path.expanduser(cask)
    if cask.endswith(".rb") and os.path.exists(expanded_rb):
        print(f"📄 Reading local file: {expanded_rb}")
        return parse_local_rb(expanded_rb)

    if cask == "newkap":
        tag, assets = get_github_release_assets("MuntasirMalek", "NewKap")
        dl_url = pick_intel_mac_asset(assets, token="NewKap", prefer_cli=False)
        return {
            "token": "newkap",
            "name": ["NewKap"],
            "desc": "Built-in screen recorder and video editor",
            "homepage": "https://github.com/MuntasirMalek/NewKap",
            "version": tag or "latest",
            "url": dl_url,
            "artifacts": [{"app": ["NewKap.app"]}],
            "variations": {},
            "depends_on": {}
        }

    # Direct GitHub owner/repo support (e.g. cask install owner/repo)
    if "/" in cask and not os.path.exists(expanded_rb):
        parts = [p for p in cask.split("/") if p]
        if len(parts) == 2:
            owner, repo = parts
            tag, assets = get_github_release_assets(owner, repo)
            dl_url = pick_intel_mac_asset(assets, token=repo, prefer_cli=prefer_formula)
            if dl_url:
                is_gui = dl_url.lower().endswith((".dmg", ".pkg", ".mpkg", ".app.tar.gz", ".app.zip"))
                artifacts = [] if is_gui else [{"binary": [repo.lower()]}]
                return {
                    "token": repo.lower(),
                    "name": [repo],
                    "desc": f"GitHub release from {owner}/{repo}",
                    "homepage": f"https://github.com/{owner}/{repo}",
                    "version": tag or "latest",
                    "url": dl_url,
                    "artifacts": artifacts,
                    "variations": {},
                    "depends_on": {},
                    "_is_formula": not is_gui
                }

    # 1. If user explicitly requested --formula, check formula first
    if prefer_formula:
        formula_data = get_formula_data(cask)
        if formula_data:
            return formula_data

    # 2. Check standard Homebrew Cask API
    cask_data = fetch_json(f"https://formulae.brew.sh/api/cask/{cask}.json")
    if cask_data:
        if prefer_cask:
            return cask_data
        return cask_data

    # 3. If user passed --cask (e.g. `cask install --cask opencode`), check `<name>-desktop` cask first
    if prefer_cask:
        for suffix in ("-desktop", "-app"):
            if not cask.endswith(suffix):
                alt_cask = fetch_json(f"https://formulae.brew.sh/api/cask/{cask}{suffix}.json")
                if alt_cask:
                    print(f"🔄 Resolved Cask '{cask}' -> '{cask}{suffix}'")
                    return alt_cask

    # 4. Fallback to Homebrew Formula API (for CLI packages like `opencode`, `ripgrep`, `gh`, `uv`, etc.)
    formula_data = get_formula_data(cask)
    if formula_data:
        companion_cask = None
        for suffix in ("-desktop", "-app"):
            if fetch_json(f"https://formulae.brew.sh/api/cask/{cask}{suffix}.json"):
                companion_cask = f"{cask}{suffix}"
                break
        if companion_cask:
            formula_data["_companion_cask"] = companion_cask
        return formula_data

    # 5. Fallback to Cask name variants (`<name>-desktop`, `<name>-app`, or stripping `-desktop`/`-app`)
    variant_candidates = [f"{cask}-desktop", f"{cask}-app", f"{cask}-cli"]
    for suffix in ("-desktop", "-app", "-cli"):
        if cask.endswith(suffix):
            variant_candidates.append(cask[:-len(suffix)])
    for candidate in variant_candidates:
        alt_cask = fetch_json(f"https://formulae.brew.sh/api/cask/{candidate}.json")
        if alt_cask:
            print(f"🔄 Resolved '{cask}' -> Cask '{candidate}'")
            return alt_cask

    return None

def get_intel_url_and_artifacts(data):
    variations = data.get("variations", {})
    artifacts = list(data.get("artifacts", []))
    dl_url = data.get("url")
    found_intel_variation = False

    for os_key in INTEL_OS_KEYS:
        if os_key in variations and isinstance(variations[os_key], dict):
            var_entry = variations[os_key]
            if "url" in var_entry or "artifacts" in var_entry:
                if "url" in var_entry:
                    dl_url = var_entry["url"]
                if "artifacts" in var_entry:
                    artifacts = list(var_entry["artifacts"])
                found_intel_variation = True
                break

    if not found_intel_variation:
        for k, v in variations.items():
            if not k.startswith("arm64") and "linux" not in k and isinstance(v, dict):
                if "url" in v or "artifacts" in v:
                    if "url" in v:
                        dl_url = v["url"]
                    if "artifacts" in v:
                        artifacts = list(v["artifacts"])
                    found_intel_variation = True
                    break

    # If the URL still points to an arm64-only asset on GitHub, check if an Intel asset exists in the same release
    if dl_url and not found_intel_variation and re.search(r"(arm64|aarch64)", dl_url, re.I):
        gh_m = re.search(r"github\.com/([^/]+)/([^/]+)/releases/download/([^/]+)/", dl_url)
        if gh_m:
            owner, repo, tag = gh_m.group(1), gh_m.group(2), gh_m.group(3)
            _, assets = get_github_release_assets(owner, repo, [tag])
            alt_url = pick_intel_mac_asset(assets, token=data.get("token", ""), prefer_cli=bool(data.get("_is_formula")))
            if alt_url:
                dl_url = alt_url

    return dl_url, artifacts

def detect_kind(filepath):
    # 1. Check if the server returned an HTML mirror page
    try:
        with open(filepath, "rb") as f:
            header = f.read(512)
        if header.lstrip().startswith((b"<!DOCTYPE", b"<!doctype", b"<html", b"<HTML", b"<?xml")):
            return "html"
    except Exception:
        header = b""

    # 2. Trust filename extensions first
    lower = filepath.lower()
    if lower.endswith(".dmg"):
        return "dmg"
    if lower.endswith((".pkg", ".mpkg")):
        return "pkg"
    if lower.endswith(".zip"):
        return "zip"
    if lower.endswith((".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz", ".tar")):
        return "tar"

    # 3. Probe extensionless or redirect URLs (including ghcr.io bottle blobs)
    if header.startswith(b"PK\x03\x04"):
        return "zip"
    if header.startswith(b"xar!"):
        return "pkg"
    if (
        header.startswith(b"\x1f\x8b")
        or header.startswith(b"\xfd7zXZ\x00")
        or header.startswith(b"BZh")
        or (len(header) >= 262 and header[257:262] == b"ustar")
    ):
        return "tar"

    res = subprocess.run(["hdiutil", "imageinfo", filepath], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode == 0:
        return "dmg"

    return "binary"

def is_macho_or_script(filepath):
    if not os.path.isfile(filepath) or os.path.islink(filepath):
        return False
    try:
        with open(filepath, "rb") as f:
            magic = f.read(4)
        if magic in (
            b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
            b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xce",
            b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca"
        ):
            return True
        if magic.startswith(b"#!"):
            return True
    except Exception:
        pass
    return False

def relocate_bottle(cask_dir):
    """
    Rewrites @@HOMEBREW_CELLAR@@ and @@HOMEBREW_PREFIX@@ placeholders in Homebrew bottles
    so they run standalone from /usr/local/Caskroom without Homebrew installed.
    """
    opt_root = None
    for root, dirs, _ in os.walk(cask_dir):
        if "bin" in dirs or "lib" in dirs:
            opt_root = root
            break
    if not opt_root:
        opt_root = cask_dir

    for root, _, files in os.walk(cask_dir):
        for fname in files:
            fpath = os.path.join(root, fname)
            if os.path.islink(fpath) or not os.path.isfile(fpath):
                continue
            try:
                with open(fpath, "rb") as f:
                    head = f.read(4)
            except Exception:
                continue

            if head in (
                b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
                b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca"
            ):
                otool = subprocess.run(["otool", "-L", fpath], capture_output=True, text=True)
                if otool.returncode == 0 and "@@HOMEBREW_" in otool.stdout:
                    try:
                        os.chmod(fpath, 0o755)
                    except Exception:
                        pass
                    changed = False
                    for line in otool.stdout.splitlines()[1:]:
                        dep = line.strip().split(" (compatibility ")[0].strip()
                        if "@@HOMEBREW_" not in dep:
                            continue
                        new_dep = re.sub(r"@@HOMEBREW_CELLAR@@/[^/]+/[^/]+", opt_root, dep)
                        new_dep = re.sub(r"@@HOMEBREW_PREFIX@@/opt/[^/]+", opt_root, new_dep)
                        new_dep = new_dep.replace("@@HOMEBREW_PREFIX@@", "/usr/local")
                        if new_dep != dep:
                            subprocess.run(["install_name_tool", "-change", dep, new_dep, fpath], stderr=subprocess.DEVNULL)
                            changed = True
                    if changed:
                        subprocess.run(["codesign", "-fs", "-", fpath], stderr=subprocess.DEVNULL)

def copy_app(src, dst):
    print(f"📦 Installing {os.path.basename(dst)} to /Applications...")
    if os.path.lexists(dst):
        try:
            shutil.rmtree(dst) if os.path.isdir(dst) and not os.path.islink(dst) else os.remove(dst)
        except PermissionError:
            run_cmd(["sudo", "rm", "-rf", dst])
    res = subprocess.run(["ditto", src, dst], stderr=subprocess.DEVNULL)
    if res.returncode != 0:
        run_cmd(["sudo", "ditto", src, dst])
    subprocess.run(["xattr", "-cr", dst], stderr=subprocess.DEVNULL)
    run_cmd(["sudo", "xattr", "-cr", dst], stderr=subprocess.DEVNULL)

def link_binary(src_path, target_name):
    os.makedirs("/usr/local/bin", exist_ok=True)
    dst_link = f"/usr/local/bin/{target_name}"
    try:
        os.chmod(src_path, 0o755)
    except PermissionError:
        run_cmd(["sudo", "chmod", "+x", src_path])
    subprocess.run(["xattr", "-cr", src_path], stderr=subprocess.DEVNULL)
    print(f"🔗 Linking CLI binary: {dst_link} -> {src_path}")
    try:
        if os.path.lexists(dst_link):
            os.remove(dst_link)
        os.symlink(src_path, dst_link)
    except PermissionError:
        run_cmd(["sudo", "ln", "-sf", src_path, dst_link])

def find_binaries_to_link(cask_dir, raw_src, target_name, is_formula=False):
    """
    Locates executable CLI binary file(s) inside /usr/local/Caskroom/<cask>
    and returns a list of (src_path, link_name) pairs.
    """
    direct_cand = os.path.join(cask_dir, raw_src.lstrip("/"))
    if os.path.isfile(direct_cand):
        return [(direct_cand, target_name)]

    rel_name = os.path.basename(raw_src)
    exact_bin_matches = []
    exact_other_matches = []
    bin_dir_executables = []
    all_executables = []

    for r, dirs, fs in os.walk(cask_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "__MACOSX"]
        rel_dir = os.path.relpath(r, cask_dir)
        parts = [] if rel_dir == "." else rel_dir.split(os.sep)
        if any(p.lower() in EXCLUDED_BIN_DIRS for p in parts):
            continue

        in_bin_dir = any(p.lower() == "bin" for p in parts)
        for fname in fs:
            if fname.startswith("."):
                continue
            fpath = os.path.join(r, fname)
            if not os.path.isfile(fpath):
                continue
            lower_f = fname.lower()

            if fname == rel_name:
                if in_bin_dir:
                    exact_bin_matches.append(fpath)
                elif is_macho_or_script(fpath) or not lower_f.endswith(EXCLUDED_BIN_EXTS):
                    exact_other_matches.append(fpath)

            if lower_f.endswith(EXCLUDED_BIN_EXTS) or lower_f in ("license", "readme", "changelog", "copying", "authors", "notice"):
                continue

            if is_macho_or_script(fpath):
                if in_bin_dir:
                    bin_dir_executables.append(fpath)
                all_executables.append(fpath)

    if exact_bin_matches:
        if is_formula and len(bin_dir_executables) > 1:
            return [(p, os.path.basename(p)) for p in bin_dir_executables]
        return [(exact_bin_matches[0], target_name)]

    if exact_other_matches:
        if is_formula and len(all_executables) > 1:
            return [(p, os.path.basename(p)) for p in all_executables]
        return [(exact_other_matches[0], target_name)]

    if bin_dir_executables:
        return [(p, os.path.basename(p)) for p in bin_dir_executables]

    if len(all_executables) == 1:
        only_exe = all_executables[0]
        exe_base = os.path.basename(only_exe)
        if re.search(r"(darwin|macos|mac|osx|amd64|x86_64|x64|intel|universal)", exe_base, re.I):
            return [(only_exe, target_name)]
        return [(only_exe, exe_base if is_formula else target_name)]

    if all_executables:
        return [(p, os.path.basename(p)) for p in all_executables]

    return []

def install_extracted(search_dir, cask, artifacts, is_formula=False, is_bottle=False):
    installed_any = False
    staged_to_caskroom = False

    for root, dirs, files in os.walk(search_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "__MACOSX"]
        for d in list(dirs):
            if d.endswith(".app"):
                if "uninstall" in d.lower():
                    dirs.remove(d)
                    continue
                src = os.path.join(root, d)
                dst = f"/Applications/{d}"
                copy_app(src, dst)
                installed_any = True
                dirs.remove(d)

    if not installed_any:
        for root, dirs, files in os.walk(search_dir):
            dirs[:] = [d for d in dirs if not d.startswith(".") and d != "__MACOSX"]
            for f in files:
                if f.lower().endswith((".pkg", ".mpkg")):
                    pkg_path = os.path.join(root, f)
                    print(f"📦 Running package installer for {f}...")
                    res = run_cmd(["sudo", "installer", "-pkg", pkg_path, "-target", "/"])
                    if res.returncode == 0:
                        installed_any = True

    for artifact in artifacts:
        if isinstance(artifact, dict) and "binary" in artifact:
            items = to_list(artifact["binary"])
            if not items or not isinstance(items[0], str):
                continue
            raw_src = items[0]
            target_name = os.path.basename(raw_src)
            if len(items) > 1 and isinstance(items[1], dict) and "target" in items[1]:
                target_name = os.path.basename(items[1]["target"])

            if "$APPDIR/" in raw_src:
                real_src = raw_src.replace("$APPDIR", "/Applications")
                if os.path.exists(real_src):
                    link_binary(real_src, target_name)
                    installed_any = True
            else:
                cask_dir = f"/usr/local/Caskroom/{cask}"
                if not staged_to_caskroom:
                    if os.path.lexists(cask_dir):
                        try:
                            shutil.rmtree(cask_dir)
                        except PermissionError:
                            run_cmd(["sudo", "rm", "-rf", cask_dir])
                    try:
                        os.makedirs(cask_dir, exist_ok=True)
                    except PermissionError:
                        run_cmd(["sudo", "mkdir", "-p", cask_dir])
                        run_cmd(["sudo", "chown", "-R", f"{os.getuid()}:admin", cask_dir])
                    subprocess.run(["ditto", search_dir, cask_dir])
                    if is_bottle:
                        relocate_bottle(cask_dir)
                    staged_to_caskroom = True

                pairs = find_binaries_to_link(cask_dir, raw_src, target_name, is_formula=is_formula)
                for src_bin_path, link_name in pairs:
                    link_binary(src_bin_path, link_name)
                    installed_any = True

    return installed_any

def download_file(url, out_path):
    cmd = ["curl", "-fL#", "--compressed", "-A", CLI_USER_AGENT]
    if "ghcr.io/" in url:
        cmd += ["-H", "Authorization: Bearer QQ=="]
    cmd += [url, "-o", out_path]
    return run_cmd(cmd)

def is_already_installed(cask, artifacts):
    """
    Checks if a cask or formula is already installed via /Applications bundle,
    CLI link in /usr/local/bin, /usr/local/Caskroom, or tracker.
    """
    has_app_or_bin_artifact = False

    for artifact in artifacts:
        if isinstance(artifact, dict):
            if "app" in artifact:
                has_app_or_bin_artifact = True
                for item in to_list(artifact["app"]):
                    app_name = item.get("target") if isinstance(item, dict) else (item if isinstance(item, str) else None)
                    if app_name:
                        app_base = os.path.basename(app_name)
                        for d in ("/Applications", os.path.expanduser("~/Applications")):
                            cand = os.path.join(d, app_base)
                            if os.path.exists(cand):
                                return True, cand
            if "target" in artifact and isinstance(artifact["target"], str):
                has_app_or_bin_artifact = True
                target_cand = artifact["target"].replace("$APPDIR", "/Applications").replace("$HOMEBREW_PREFIX", "/usr/local")
                if os.path.exists(target_cand):
                    return True, target_cand

            if "binary" in artifact:
                has_app_or_bin_artifact = True
                items = to_list(artifact["binary"])
                if items and isinstance(items[0], str):
                    target_name = os.path.basename(items[0])
                    if len(items) > 1 and isinstance(items[1], dict) and "target" in items[1]:
                        target_name = os.path.basename(items[1]["target"])
                    bin_cand = f"/usr/local/bin/{target_name}"
                    if os.path.exists(bin_cand):
                        return True, bin_cand

    cask_dir = f"/usr/local/Caskroom/{cask}"
    if os.path.isdir(cask_dir) and os.listdir(cask_dir):
        return True, cask_dir

    tracker = os.path.expanduser("~/.installed_casks.txt")
    if not has_app_or_bin_artifact and os.path.exists(tracker):
        with open(tracker, "r") as f:
            existing = [line.strip() for line in f if line.strip()]
        if cask in existing:
            return True, f"recorded in {tracker}"

    return False, ""

def record_cask_installed(cask):
    tracker = os.path.expanduser("~/.installed_casks.txt")
    existing = []
    if os.path.exists(tracker):
        with open(tracker, "r") as f:
            existing = [line.strip() for line in f if line.strip()]
    if cask not in existing:
        existing.append(cask)
        with open(tracker, "w") as f:
            f.write("\n".join(existing) + "\n")

def install_cask(cask_arg, force=False, prefer_cask=False, prefer_formula=False):
    data = get_cask_data(cask_arg, prefer_cask=prefer_cask, prefer_formula=prefer_formula)
    if not data:
        print(f"❌ Could not find Cask or Formula '{cask_arg}'.")
        return False

    cask = data.get("token", cask_arg)
    is_formula = bool(data.get("_is_formula"))
    is_bottle = bool(data.get("_is_bottle"))
    companion_cask = data.get("_companion_cask")

    if is_formula:
        print(f"📦 Resolved '{cask}' via Homebrew Formula ({data.get('version', 'latest')}).")
        if companion_cask:
            print(f"💡 Tip: Desktop GUI app is also available via 'cask install {companion_cask}'.")

    dl_url, artifacts = get_intel_url_and_artifacts(data)

    if not force:
        installed, reason = is_already_installed(cask, artifacts)
        if installed:
            print(f"⚠️  '{cask}' is already installed ({reason}).")
            print(f"👉 Use 'cask reinstall {cask}' or add '--force' to reinstall.\n")
            if not cask_arg.endswith(".rb"):
                record_cask_installed(cask)
            return True

    if not dl_url:
        print(f"❌ No Intel/Universal download URL found for '{cask}'.")
        return False

    top_deps = data.get("depends_on", {})
    if isinstance(top_deps, dict) and "cask" in top_deps:
        for dep in to_list(top_deps["cask"]):
            print(f"🔄 Checking dependency cask: {dep}...")
            install_cask(dep, force=False)
    for artifact in artifacts:
        if isinstance(artifact, dict) and "depends_on" in artifact:
            deps = artifact["depends_on"].get("cask", [])
            for dep in to_list(deps):
                print(f"🔄 Checking dependency cask: {dep}...")
                install_cask(dep, force=False)

    print(f"⬇️  Downloading '{cask}' from:\n   {dl_url}")
    tmp_dir = tempfile.mkdtemp(prefix=f"cask_{cask}_")
    raw_name = dl_url.split("?")[0].rstrip("/").split("/")[-1] or f"{cask}_dl"
    if raw_name.startswith("sha256:"):
        raw_name = f"{cask}.tar.gz"
    dl_path = os.path.join(tmp_dir, raw_name)

    mount_point = None
    installed_successfully = False

    try:
        res = download_file(dl_url, dl_path)
        if res.returncode != 0 or not os.path.exists(dl_path):
            print(f"❌ Failed to download '{cask}'.")
            return False

        kind = detect_kind(dl_path)

        # Handle mirror landing pages that return HTML instead of the archive
        if kind == "html":
            print("🔍 Extracting direct download link from mirror page...")
            with open(dl_path, "r", encoding="utf-8", errors="ignore") as f:
                html_text = f.read()

            meta_m = re.search(r'URL=[\'"]?([^\'">\s]+)', html_text, re.IGNORECASE)
            href_m = re.findall(r'href=["\x27](https?://[^"\x27]+\.(?:dmg|pkg|zip|tar\.gz|tgz|tar\.xz))["\x27]', html_text)

            resolved_url = meta_m.group(1) if meta_m else (href_m[0] if href_m else None)
            if resolved_url:
                print(f"⬇️  Redirecting to: {resolved_url}")
                os.remove(dl_path)
                res = download_file(resolved_url, dl_path)
                kind = detect_kind(dl_path)
            else:
                print("❌ Download URL served an HTML landing page without a binary link.")
                return False

        if kind == "dmg":
            print("💿 Mounting DMG...")
            attach_res = subprocess.run(
                ["hdiutil", "attach", "-nobrowse", "-readonly", "-plist", dl_path],
                input=b"Y\n",
                capture_output=True
            )
            if attach_res.returncode == 0:
                try:
                    plist_data = plistlib.loads(attach_res.stdout)
                    for entity in plist_data.get("system-entities", []):
                        if "mount-point" in entity:
                            mount_point = entity["mount-point"]
                            break
                except Exception:
                    mount_point = None

            if not mount_point or not os.path.exists(mount_point):
                mount_root = os.path.join(tmp_dir, "mnt")
                os.makedirs(mount_root, exist_ok=True)
                subprocess.run(
                    ["hdiutil", "attach", "-nobrowse", "-readonly", "-mountrandom", mount_root, dl_path],
                    input=b"Y\n",
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
                for entry in os.listdir(mount_root):
                    cand = os.path.join(mount_root, entry)
                    if os.path.isdir(cand):
                        mount_point = cand
                        break
                if not mount_point:
                    mount_point = mount_root

            installed_successfully = install_extracted(mount_point, cask, artifacts, is_formula=is_formula, is_bottle=is_bottle)
        elif kind == "zip":
            extract_dir = os.path.join(tmp_dir, "extracted")
            print("📂 Extracting ZIP archive...")
            subprocess.run(["ditto", "-x", "-k", dl_path, extract_dir])
            installed_successfully = install_extracted(extract_dir, cask, artifacts, is_formula=is_formula, is_bottle=is_bottle)
        elif kind == "tar":
            extract_dir = os.path.join(tmp_dir, "extracted")
            os.makedirs(extract_dir, exist_ok=True)
            print("📂 Extracting TAR archive...")
            subprocess.run(["tar", "-xf", dl_path, "-C", extract_dir])
            installed_successfully = install_extracted(extract_dir, cask, artifacts, is_formula=is_formula, is_bottle=is_bottle)
        elif kind == "pkg":
            pkg_file = dl_path if dl_path.lower().endswith((".pkg", ".mpkg")) else dl_path + ".pkg"
            if pkg_file != dl_path:
                os.rename(dl_path, pkg_file)
            print("📦 Running PKG installer...")
            pkg_res = run_cmd(["sudo", "installer", "-pkg", pkg_file, "-target", "/"])
            installed_successfully = (pkg_res.returncode == 0)
        elif kind == "binary":
            extract_dir = os.path.join(tmp_dir, "bin_stage")
            os.makedirs(extract_dir, exist_ok=True)
            shutil.move(dl_path, os.path.join(extract_dir, raw_name))
            installed_successfully = install_extracted(extract_dir, cask, artifacts, is_formula=is_formula, is_bottle=is_bottle)

    finally:
        if mount_point:
            subprocess.run(["hdiutil", "detach", mount_point, "-quiet", "-force"], stderr=subprocess.DEVNULL)
        shutil.rmtree(tmp_dir, ignore_errors=True)

    if installed_successfully:
        if not cask_arg.endswith(".rb"):
            record_cask_installed(cask)
        print(f"✅ Successfully installed '{cask}'!\n")
        return True
    else:
        print(f"❌ Failed to install '{cask}'. No application bundle or CLI binary was installed.\n")
        return False

def cleanup_cache():
    print("🧹 Cleaning up temporary download directories and orphaned caches...")
    cleaned = 0
    temp_dir = tempfile.gettempdir()
    for entry in glob.glob(os.path.join(temp_dir, "cask_*")):
        try:
            if os.path.isdir(entry):
                shutil.rmtree(entry, ignore_errors=True)
            else:
                os.remove(entry)
            cleaned += 1
        except Exception:
            pass
    for entry in glob.glob("/tmp/cask_*"):
        try:
            if os.path.isdir(entry):
                shutil.rmtree(entry, ignore_errors=True)
            else:
                os.remove(entry)
            cleaned += 1
        except Exception:
            pass
    print(f"✨ Cleanup complete! Removed {cleaned} temporary cask file(s)/folder(s).\n")

def info_cask(cask_arg, prefer_cask=False, prefer_formula=False):
    data = get_cask_data(cask_arg, prefer_cask=prefer_cask, prefer_formula=prefer_formula)
    if not data:
        print(f"❌ Could not find Cask or Formula '{cask_arg}'.")
        return
    dl_url, _ = get_intel_url_and_artifacts(data)
    names = ", ".join(data.get("name", [cask_arg]))
    kind_label = "Formula" if data.get("_is_formula") else "Cask"
    print(f"📌 {data.get('token', cask_arg)} ({data.get('version', 'unknown')}) [{kind_label}]")
    print(f"   Name:     {names}")
    print(f"   Desc:     {data.get('desc', 'N/A')}")
    print(f"   Homepage: {data.get('homepage', 'N/A')}")
    print(f"   Intel DL: {dl_url}")
    if data.get("_companion_cask"):
        print(f"   GUI Cask: {data['_companion_cask']} (run 'cask install {data['_companion_cask']}')")

def print_usage():
    print("Usage:")
    print("  cask install [--force] <app_or_formula ...>  Install GUI Casks, CLI Formulae, GitHub repos, or .rb files")
    print("  cask reinstall <app1> [app2 ...]             Reinstall packages even if already installed")
    print("  cask zap <app1> [app2 ...]                   Completely uninstall apps, CLI binaries, and Library files")
    print("  cask info <app>                              Show version and Intel download URL for a Cask or Formula")
    print("  cask list                                    List all tracked packages in ~/.installed_casks.txt")
    print("  cask upgrade-all                             Reinstall/update all tracked packages to latest")
    print("  cask cleanup                                 Clean up leftover temporary download directories")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_usage()
        sys.exit(0 if len(sys.argv) >= 2 else 1)

    action = sys.argv[1]
    args = sys.argv[2:]

    if action in ("zap", "uninstall", "remove", "rm"):
        zap_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "zap")
        if not os.path.exists(zap_bin):
            zap_bin = "zap"
        sys.exit(subprocess.call([zap_bin] + args))

    if action == "cleanup":
        cleanup_cache()
        sys.exit(0)

    if action in ("list", "ls"):
        tracker = os.path.expanduser("~/.installed_casks.txt")
        if os.path.exists(tracker) and os.path.getsize(tracker) > 0:
            with open(tracker, "r") as f:
                print(f.read().strip())
        else:
            print("No casks tracked yet.")
        sys.exit(0)

    if action == "info":
        prefer_cask = "--cask" in args
        prefer_formula = "--formula" in args
        targets = [a for a in args if a not in ("--cask", "--formula")]
        for a in targets:
            info_cask(a, prefer_cask=prefer_cask, prefer_formula=prefer_formula)
        sys.exit(0)

    if action == "upgrade-all":
        tracker = os.path.expanduser("~/.installed_casks.txt")
        if not os.path.exists(tracker) or os.path.getsize(tracker) == 0:
            print("No installed casks found in ~/.installed_casks.txt")
            sys.exit(0)
        with open(tracker, "r") as f:
            all_apps = [line.strip() for line in f if line.strip()]
        for app in all_apps:
            install_cask(app, force=True)
        sys.exit(0)

    if action in ("install", "reinstall", "upgrade"):
        force = (action in ("reinstall", "upgrade"))
        prefer_cask = False
        prefer_formula = False
        cask_targets = []
        for arg in args:
            if arg in ("--force", "-f"):
                force = True
            elif arg in ("--cask", "--casks"):
                prefer_cask = True
            elif arg in ("--formula", "--formulae"):
                prefer_formula = True
            else:
                cask_targets.append(arg)

        if not cask_targets:
            print(f"❌ Please specify at least one package to {action}.")
            sys.exit(1)
        success_all = True
        for app in cask_targets:
            if not install_cask(app, force=force, prefer_cask=prefer_cask, prefer_formula=prefer_formula):
                success_all = False
        sys.exit(0 if success_all else 1)

    print(f"❌ Unknown action: {action}")
    print_usage()
    sys.exit(1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n🛑 Operation cancelled by user.")
        sys.exit(130)

#!/usr/bin/env python3
# cask - Standalone Homebrew-free macOS GUI app installer & updater for Intel Macs.
import sys, urllib.request, json, os, re, glob, shutil, subprocess, tempfile, plistlib

CLI_USER_AGENT = "intel-cask/1.0 (Macintosh; Intel Mac OS X; x86_64) curl/8.0"

def run_cmd(cmd, **kwargs):
    if cmd and cmd[0] == "sudo":
        try:
            with open("/dev/tty", "rb") as tty:
                return subprocess.run(cmd, stdin=tty, **kwargs)
        except Exception:
            return subprocess.run(cmd, **kwargs)
    return subprocess.run(cmd, **kwargs)

def to_list(val):
    if isinstance(val, list):
        return val
    return [val] if val else []

def parse_local_rb(rb_path):
    with open(rb_path, "r") as f:
        raw_content = f.read()

    content = re.sub(r'livecheck\s+do\b.*?\bend\b', '', raw_content, flags=re.DOTALL)
    token_m = re.search(r'cask\s+["\x27]([^"\x27]+)["\x27]', content)
    token = token_m.group(1) if token_m else os.path.basename(rb_path).replace(".rb", "")

    arch_m = re.search(r'arch\s+.*?intel:\s*["\x27]([^"\x27]+)["\x27]', content)
    intel_arch = arch_m.group(1) if arch_m else "x86_64"

    intel_block = re.search(r'on_intel\s+do(.*?)end', content, re.DOTALL)
    sub = intel_block.group(1) if intel_block else content

    ver_m = re.search(r'version\s+["\x27]([^"\x27]+)["\x27]', sub) or re.search(r'version\s+["\x27]([^"\x27]+)["\x27]', content)
    version = ver_m.group(1) if ver_m else ""
    parts = version.split(",")

    url_m = re.search(r'url\s+["\x27]([^"\x27]+)["\x27]', sub) or re.search(r'url\s+["\x27]([^"\x27]+)["\x27]', content)
    if not url_m:
        return None
    url = url_m.group(1)
    url = url.replace("#{version.csv.first}", parts[0] if parts else "")
    if len(parts) > 1:
        url = url.replace("#{version.csv.second}", parts[1])
    if len(parts) > 2:
        url = url.replace("#{version.csv.third}", parts[2])
    url = url.replace("#{version}", version)
    url = re.sub(r'#\{arch\}', intel_arch, url)

    apps = re.findall(r'\bapp\s+["\x27]([^"\x27]+)["\x27]', content)
    pkgs = re.findall(r'\bpkg\s+["\x27]([^"\x27]+)["\x27]', content)
    bins = re.findall(r'\bbinary\s+["\x27]([^"\x27]+)["\x27](?:\s*,\s*target:\s*["\x27]([^"\x27]+)["\x27])?', content)
    artifacts = []
    if apps:
        artifacts.append({"app": apps})
    if pkgs:
        artifacts.append({"pkg": pkgs})
    for src_bin, target_bin in bins:
        src_bin = src_bin.replace("#{appdir}", "$APPDIR").replace("#{staged_path}", f"/usr/local/Caskroom/{token}")
        if target_bin:
            artifacts.append({"binary": [src_bin, {"target": target_bin}]})
        else:
            artifacts.append({"binary": [src_bin]})
    return {"token": token, "version": version, "url": url, "artifacts": artifacts, "variations": {}, "depends_on": {}}

def get_cask_data(cask):
    expanded_rb = os.path.expanduser(cask)
    if cask.endswith(".rb") and os.path.exists(expanded_rb):
        print(f"📄 Reading local Cask file: {expanded_rb}")
        return parse_local_rb(expanded_rb)

    if cask == "newkap":
        req = urllib.request.Request("https://api.github.com/repos/MuntasirMalek/NewKap/releases/latest", headers={"User-Agent": CLI_USER_AGENT})
        with urllib.request.urlopen(req, timeout=15) as resp:
            rel = json.loads(resp.read().decode())
        dl_url = None
        for asset in rel.get("assets", []):
            name = asset.get("name", "")
            if name.endswith("-x64.dmg") or (name.endswith(".dmg") and "arm64" not in name):
                dl_url = asset.get("browser_download_url")
                break
        return {"token": "newkap", "version": rel.get("tag_name", "latest"), "url": dl_url, "artifacts": [{"app": ["NewKap.app"]}], "variations": {}, "depends_on": {}}

    url = f"https://formulae.brew.sh/api/cask/{cask}.json"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": CLI_USER_AGENT})
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None

def get_intel_url_and_artifacts(data):
    variations = data.get("variations", {})
    artifacts = list(data.get("artifacts", []))
    dl_url = data.get("url")

    for os_key in ["golden_gate", "tahoe", "sequoia", "sonoma", "ventura", "monterey", "big_sur", "catalina", "x86_64"]:
        if os_key in variations:
            if "url" in variations[os_key]:
                dl_url = variations[os_key]["url"]
            if "artifacts" in variations[os_key]:
                artifacts = list(variations[os_key]["artifacts"])
            return dl_url, artifacts

    for k, v in variations.items():
        if not k.startswith("arm64") and "linux" not in k and isinstance(v, dict):
            if "url" in v:
                dl_url = v["url"]
            if "artifacts" in v:
                artifacts = list(variations[k]["artifacts"])
            return dl_url, artifacts

    return dl_url, artifacts

def detect_kind(filepath):
    # 1. Check if the server returned an HTML mirror page
    try:
        with open(filepath, "rb") as f:
            header = f.read(512)
        if header.lstrip().startswith((b"<!DOCTYPE", b"<!doctype", b"<html", b"<HTML", b"<?xml")):
            return "html"
    except Exception:
        header = b""

    # 2. Trust filename extensions first
    lower = filepath.lower()
    if lower.endswith(".dmg"):
        return "dmg"
    if lower.endswith((".pkg", ".mpkg")):
        return "pkg"
    if lower.endswith(".zip"):
        return "zip"
    if lower.endswith((".tar.gz", ".tgz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz", ".tar")):
        return "tar"

    # 3. Probe extensionless or redirect URLs
    res = subprocess.run(["hdiutil", "imageinfo", filepath], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode == 0:
        return "dmg"

    if header.startswith(b"PK\x03\x04"):
        return "zip"
    if header.startswith(b"xar!"):
        return "pkg"
    if len(header) >= 262 and header[257:262] == b"ustar":
        return "tar"

    return "binary"

def copy_app(src, dst):
    print(f"📦 Installing {os.path.basename(dst)} to /Applications...")
    if os.path.lexists(dst):
        try:
            shutil.rmtree(dst) if os.path.isdir(dst) and not os.path.islink(dst) else os.remove(dst)
        except PermissionError:
            run_cmd(["sudo", "rm", "-rf", dst])
    res = subprocess.run(["ditto", src, dst], stderr=subprocess.DEVNULL)
    if res.returncode != 0:
        run_cmd(["sudo", "ditto", src, dst])
    subprocess.run(["xattr", "-cr", dst], stderr=subprocess.DEVNULL)
    run_cmd(["sudo", "xattr", "-cr", dst], stderr=subprocess.DEVNULL)

def link_binary(src_path, target_name):
    os.makedirs("/usr/local/bin", exist_ok=True)
    dst_link = f"/usr/local/bin/{target_name}"
    try:
        os.chmod(src_path, 0o755)
    except PermissionError:
        run_cmd(["sudo", "chmod", "+x", src_path])
    subprocess.run(["xattr", "-cr", src_path], stderr=subprocess.DEVNULL)
    print(f"🔗 Linking CLI binary: {dst_link} -> {src_path}")
    try:
        if os.path.lexists(dst_link):
            os.remove(dst_link)
        os.symlink(src_path, dst_link)
    except PermissionError:
        run_cmd(["sudo", "ln", "-sf", src_path, dst_link])

def install_extracted(search_dir, cask, artifacts):
    installed_any = False
    staged_to_caskroom = False

    for root, dirs, files in os.walk(search_dir):
        for d in list(dirs):
            if d.endswith(".app"):
                if "uninstall" in d.lower():
                    dirs.remove(d)
                    continue
                src = os.path.join(root, d)
                dst = f"/Applications/{d}"
                copy_app(src, dst)
                installed_any = True
                dirs.remove(d)

    if not installed_any:
        for root, dirs, files in os.walk(search_dir):
            for f in files:
                if f.lower().endswith((".pkg", ".mpkg")):
                    pkg_path = os.path.join(root, f)
                    print(f"📦 Running package installer for {f}...")
                    res = run_cmd(["sudo", "installer", "-pkg", pkg_path, "-target", "/"])
                    if res.returncode == 0:
                        installed_any = True

    for artifact in artifacts:
        if isinstance(artifact, dict) and "binary" in artifact:
            items = to_list(artifact["binary"])
            if not items or not isinstance(items[0], str):
                continue
            raw_src = items[0]
            target_name = os.path.basename(raw_src)
            if len(items) > 1 and isinstance(items[1], dict) and "target" in items[1]:
                target_name = os.path.basename(items[1]["target"])

            if "$APPDIR/" in raw_src:
                real_src = raw_src.replace("$APPDIR", "/Applications")
                if os.path.exists(real_src):
                    link_binary(real_src, target_name)
            else:
                cask_dir = f"/usr/local/Caskroom/{cask}"
                if not staged_to_caskroom:
                    if os.path.lexists(cask_dir):
                        try:
                            shutil.rmtree(cask_dir)
                        except PermissionError:
                            run_cmd(["sudo", "rm", "-rf", cask_dir])
                    try:
                        os.makedirs(cask_dir, exist_ok=True)
                    except PermissionError:
                        run_cmd(["sudo", "mkdir", "-p", cask_dir])
                        run_cmd(["sudo", "chown", "-R", f"{os.getuid()}:admin", cask_dir])
                    subprocess.run(["ditto", search_dir, cask_dir])
                    staged_to_caskroom = True
                rel_name = os.path.basename(raw_src)
                for r, _, fs in os.walk(cask_dir):
                    if rel_name in fs:
                        link_binary(os.path.join(r, rel_name), target_name)
                        break

    return installed_any

def download_file(url, out_path):
    return run_cmd(["curl", "-fL#", "--compressed", "-A", CLI_USER_AGENT, url, "-o", out_path])

def is_already_installed(cask, artifacts):
    """
    Checks if a cask is already installed via tracker, /Applications bundle, or CLI link.
    """
    tracker = os.path.expanduser("~/.installed_casks.txt")
    if os.path.exists(tracker):
        with open(tracker, "r") as f:
            existing = [line.strip() for line in f if line.strip()]
        if cask in existing:
            return True, f"recorded in {tracker}"

    for artifact in artifacts:
        if isinstance(artifact, dict):
            if "app" in artifact:
                for item in to_list(artifact["app"]):
                    app_name = item.get("target") if isinstance(item, dict) else (item if isinstance(item, str) else None)
                    if app_name:
                        app_base = os.path.basename(app_name)
                        for d in ("/Applications", os.path.expanduser("~/Applications")):
                            cand = os.path.join(d, app_base)
                            if os.path.exists(cand):
                                return True, cand
            if "target" in artifact and isinstance(artifact["target"], str):
                target_cand = artifact["target"].replace("$APPDIR", "/Applications").replace("$HOMEBREW_PREFIX", "/usr/local")
                if os.path.exists(target_cand):
                    return True, target_cand

            if "binary" in artifact:
                items = to_list(artifact["binary"])
                if items and isinstance(items[0], str):
                    target_name = os.path.basename(items[0])
                    if len(items) > 1 and isinstance(items[1], dict) and "target" in items[1]:
                        target_name = os.path.basename(items[1]["target"])
                    bin_cand = f"/usr/local/bin/{target_name}"
                    if os.path.exists(bin_cand):
                        return True, bin_cand

    cask_dir = f"/usr/local/Caskroom/{cask}"
    if os.path.isdir(cask_dir) and os.listdir(cask_dir):
        return True, cask_dir

    return False, ""

def record_cask_installed(cask):
    tracker = os.path.expanduser("~/.installed_casks.txt")
    existing = []
    if os.path.exists(tracker):
        with open(tracker, "r") as f:
            existing = [line.strip() for line in f if line.strip()]
    if cask not in existing:
        existing.append(cask)
        with open(tracker, "w") as f:
            f.write("\n".join(existing) + "\n")

def install_cask(cask_arg, force=False):
    data = get_cask_data(cask_arg)
    if not data:
        print(f"❌ Could not find Cask '{cask_arg}'.")
        return False
    cask = data.get("token", cask_arg)
    dl_url, artifacts = get_intel_url_and_artifacts(data)

    if not force:
        installed, reason = is_already_installed(cask, artifacts)
        if installed:
            print(f"⚠️  Cask '{cask}' is already installed ({reason}).")
            print(f"👉 Use 'cask reinstall {cask}' or add '--force' to reinstall.\n")
            if not cask_arg.endswith(".rb"):
                record_cask_installed(cask)
            return True

    if not dl_url:
        print(f"❌ No Intel/Universal download URL found for '{cask}'.")
        return False

    top_deps = data.get("depends_on", {})
    if isinstance(top_deps, dict) and "cask" in top_deps:
        for dep in to_list(top_deps["cask"]):
            print(f"🔄 Checking dependency cask: {dep}...")
            install_cask(dep, force=False)
    for artifact in artifacts:
        if isinstance(artifact, dict) and "depends_on" in artifact:
            deps = artifact["depends_on"].get("cask", [])
            for dep in to_list(deps):
                print(f"🔄 Checking dependency cask: {dep}...")
                install_cask(dep, force=False)

    print(f"⬇️  Downloading '{cask}' from:\n   {dl_url}")
    tmp_dir = tempfile.mkdtemp(prefix=f"cask_{cask}_")
    raw_name = dl_url.split("?")[0].rstrip("/").split("/")[-1] or f"{cask}_dl"
    dl_path = os.path.join(tmp_dir, raw_name)

    mount_point = None
    installed_successfully = False

    try:
        res = download_file(dl_url, dl_path)
        if res.returncode != 0 or not os.path.exists(dl_path):
            print(f"❌ Failed to download '{cask}'.")
            return False

        kind = detect_kind(dl_path)

        # Handle mirror landing pages that return HTML instead of the archive
        if kind == "html":
            print("🔍 Extracting direct download link from mirror page...")
            with open(dl_path, "r", encoding="utf-8", errors="ignore") as f:
                html_text = f.read()

            meta_m = re.search(r'URL=[\'"]?([^\'">\s]+)', html_text, re.IGNORECASE)
            href_m = re.findall(r'href=["\x27](https?://[^"\x27]+\.(?:dmg|pkg|zip|tar\.gz))["\x27]', html_text)

            resolved_url = meta_m.group(1) if meta_m else (href_m[0] if href_m else None)
            if resolved_url:
                print(f"⬇️  Redirecting to: {resolved_url}")
                os.remove(dl_path)
                res = download_file(resolved_url, dl_path)
                kind = detect_kind(dl_path)
            else:
                print("❌ Download URL served an HTML landing page without a binary link.")
                return False

        if kind == "dmg":
            print("💿 Mounting DMG...")
            attach_res = subprocess.run(
                ["hdiutil", "attach", "-nobrowse", "-readonly", "-plist", dl_path],
                input=b"Y\n",
                capture_output=True
            )
            if attach_res.returncode == 0:
                try:
                    plist_data = plistlib.loads(attach_res.stdout)
                    for entity in plist_data.get("system-entities", []):
                        if "mount-point" in entity:
                            mount_point = entity["mount-point"]
                            break
                except Exception:
                    mount_point = None

            if not mount_point or not os.path.exists(mount_point):
                mount_root = os.path.join(tmp_dir, "mnt")
                os.makedirs(mount_root, exist_ok=True)
                subprocess.run(
                    ["hdiutil", "attach", "-nobrowse", "-readonly", "-mountrandom", mount_root, dl_path],
                    input=b"Y\n",
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
                for entry in os.listdir(mount_root):
                    cand = os.path.join(mount_root, entry)
                    if os.path.isdir(cand):
                        mount_point = cand
                        break
                if not mount_point:
                    mount_point = mount_root

            installed_successfully = install_extracted(mount_point, cask, artifacts)
        elif kind == "zip":
            extract_dir = os.path.join(tmp_dir, "extracted")
            print("📂 Extracting ZIP archive...")
            subprocess.run(["ditto", "-x", "-k", dl_path, extract_dir])
            installed_successfully = install_extracted(extract_dir, cask, artifacts)
        elif kind == "tar":
            extract_dir = os.path.join(tmp_dir, "extracted")
            os.makedirs(extract_dir, exist_ok=True)
            print("📂 Extracting TAR archive...")
            subprocess.run(["tar", "-xf", dl_path, "-C", extract_dir])
            installed_successfully = install_extracted(extract_dir, cask, artifacts)
        elif kind == "pkg":
            pkg_file = dl_path if dl_path.lower().endswith((".pkg", ".mpkg")) else dl_path + ".pkg"
            if pkg_file != dl_path:
                os.rename(dl_path, pkg_file)
            print("📦 Running PKG installer...")
            pkg_res = run_cmd(["sudo", "installer", "-pkg", pkg_file, "-target", "/"])
            installed_successfully = (pkg_res.returncode == 0)
        elif kind == "binary":
            extract_dir = os.path.join(tmp_dir, "bin_stage")
            os.makedirs(extract_dir, exist_ok=True)
            shutil.move(dl_path, os.path.join(extract_dir, raw_name))
            installed_successfully = install_extracted(extract_dir, cask, artifacts)

    finally:
        if mount_point:
            subprocess.run(["hdiutil", "detach", mount_point, "-quiet", "-force"], stderr=subprocess.DEVNULL)
        shutil.rmtree(tmp_dir, ignore_errors=True)

    if installed_successfully:
        if not cask_arg.endswith(".rb"):
            record_cask_installed(cask)
        print(f"✅ Successfully installed '{cask}'!\n")
        return True
    else:
        print(f"❌ Failed to install '{cask}'. No application bundle was transferred to /Applications.\n")
        return False

def cleanup_cache():
    print("🧹 Cleaning up temporary download directories and orphaned caches...")
    cleaned = 0
    temp_dir = tempfile.gettempdir()
    for entry in glob.glob(os.path.join(temp_dir, "cask_*")):
        try:
            if os.path.isdir(entry):
                shutil.rmtree(entry, ignore_errors=True)
            else:
                os.remove(entry)
            cleaned += 1
        except Exception:
            pass
    for entry in glob.glob("/tmp/cask_*"):
        try:
            if os.path.isdir(entry):
                shutil.rmtree(entry, ignore_errors=True)
            else:
                os.remove(entry)
            cleaned += 1
        except Exception:
            pass
    print(f"✨ Cleanup complete! Removed {cleaned} temporary cask file(s)/folder(s).\n")

def info_cask(cask_arg):
    data = get_cask_data(cask_arg)
    if not data:
        print(f"❌ Could not find Cask '{cask_arg}'.")
        return
    dl_url, _ = get_intel_url_and_artifacts(data)
    names = ", ".join(data.get("name", [cask_arg]))
    print(f"📌 {data.get('token', cask_arg)} ({data.get('version', 'unknown')})")
    print(f"   Name:     {names}")
    print(f"   Desc:     {data.get('desc', 'N/A')}")
    print(f"   Homepage: {data.get('homepage', 'N/A')}")
    print(f"   Intel DL: {dl_url}")

def print_usage():
    print("Usage:")
    print("  cask install [--force] <app1> [app2 ...]   Install GUI apps or local .rb Cask files")
    print("  cask reinstall <app1> [app2 ...]          Reinstall apps even if already installed")
    print("  cask zap <app1> [app2 ...]                Completely uninstall apps and hidden Library files")
    print("  cask info <app>                           Show version and Intel download URL for a Cask")
    print("  cask list                                 List all tracked casks in ~/.installed_casks.txt")
    print("  cask upgrade-all                          Reinstall/update all tracked casks to latest")
    print("  cask cleanup                              Clean up leftover temporary download directories")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_usage()
        sys.exit(0 if len(sys.argv) >= 2 else 1)

    action = sys.argv[1]
    args = sys.argv[2:]

    if action in ("zap", "uninstall"):
        zap_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "zap")
        if not os.path.exists(zap_bin):
            zap_bin = "zap"
        sys.exit(subprocess.call([zap_bin] + args))

    if action == "cleanup":
        cleanup_cache()
        sys.exit(0)

    if action == "list":
        tracker = os.path.expanduser("~/.installed_casks.txt")
        if os.path.exists(tracker) and os.path.getsize(tracker) > 0:
            with open(tracker, "r") as f:
                print(f.read().strip())
        else:
            print("No casks tracked yet.")
        sys.exit(0)

    if action == "info":
        for a in args:
            info_cask(a)
        sys.exit(0)

    if action == "upgrade-all":
        tracker = os.path.expanduser("~/.installed_casks.txt")
        if not os.path.exists(tracker) or os.path.getsize(tracker) == 0:
            print("No installed casks found in ~/.installed_casks.txt")
            sys.exit(0)
        with open(tracker, "r") as f:
            all_apps = [line.strip() for line in f if line.strip()]
        for app in all_apps:
            install_cask(app, force=True)
        sys.exit(0)

    if action in ("install", "reinstall", "upgrade"):
        force = (action in ("reinstall", "upgrade"))
        cask_targets = []
        for arg in args:
            if arg in ("--force", "-f"):
                force = True
            else:
                cask_targets.append(arg)

        if not cask_targets:
            print(f"❌ Please specify at least one cask to {action}.")
            sys.exit(1)
        for app in cask_targets:
            install_cask(app, force=force)
        sys.exit(0)

    print(f"❌ Unknown action: {action}")
    print_usage()
    sys.exit(1)

if __name__ == "__main__":
    main()

#!/usr/bin/env python3
# zap - Standalone deep uninstaller for macOS GUI applications and CLI formulae.
import sys, urllib.request, urllib.parse, json, os, re, glob, shutil, subprocess, time, signal, platform, plistlib, fnmatch

CLI_USER_AGENT = "intel-cask/1.0 (Macintosh; Intel Mac OS X; x86_64) curl/8.0"

MACOS_ORDER = [
    "golden_gate", "tahoe", "sequoia", "sonoma", "ventura",
    "monterey", "big_sur", "catalina", "mojave", "high_sierra"
]

def get_host_macos_codename():
    ver = platform.mac_ver()[0]
    if ver:
        parts = ver.split(".")
        try:
            major = int(parts[0])
            minor = int(parts[1]) if len(parts) > 1 else 0
            if major >= 27:
                return "golden_gate"
            if major == 26:
                return "tahoe"
            if major == 15:
                return "sequoia"
            if major == 14:
                return "sonoma"
            if major == 13:
                return "ventura"
            if major == 12:
                return "monterey"
            if major == 11:
                return "big_sur"
            if major == 10:
                if minor >= 15:
                    return "catalina"
                if minor == 14:
                    return "mojave"
                if minor == 13:
                    return "high_sierra"
        except ValueError:
            pass
    return "sequoia"

def run_cmd(cmd, **kwargs):
    if cmd and cmd[0] == "sudo":
        try:
            with open("/dev/tty", "rb") as tty:
                return subprocess.run(cmd, stdin=tty, **kwargs)
        except Exception:
            return subprocess.run(cmd, **kwargs)
    return subprocess.run(cmd, **kwargs)

def to_list(val):
    if isinstance(val, list):
        return val
    return [val] if val else []

def expand_cask_path(p):
    uid = str(os.getuid())
    home = os.path.expanduser("~")
    p = p.replace("$(id -u)", uid)
    p = p.replace("$HOMEBREW_PREFIX", "/usr/local").replace("$APPDIR", "/Applications")
    p = re.sub(r"/?\$HOME(?![A-Za-z0-9_])", lambda _: home, p)
    return os.path.expanduser(p)

def get_protected_paths():
    home = os.path.expanduser("~")
    raw = [
        "/", "/Applications", "/Library", "/Library/Application Support",
        "/Library/Caches", "/Library/LaunchAgents", "/Library/LaunchDaemons",
        "/Library/Preferences", "/Library/PrivilegedHelperTools",
        "/System", "/Users", "/usr", "/usr/local", "/usr/local/bin",
        "/usr/local/Caskroom", "/usr/local/lib", "/usr/local/share",
        "/tmp", "/private/tmp", "/var", "/private/var", "/etc", "/private/etc",
        home,
        os.path.join(home, "Applications"),
        os.path.join(home, "Library"),
        os.path.join(home, "Library/Application Support"),
        os.path.join(home, "Library/Application Scripts"),
        os.path.join(home, "Library/Caches"),
        os.path.join(home, "Library/Containers"),
        os.path.join(home, "Library/Cookies"),
        os.path.join(home, "Library/Group Containers"),
        os.path.join(home, "Library/HTTPStorages"),
        os.path.join(home, "Library/LaunchAgents"),
        os.path.join(home, "Library/Logs"),
        os.path.join(home, "Library/Preferences"),
        os.path.join(home, "Library/Saved Application State"),
        os.path.join(home, "Library/WebKit"),
        os.path.join(home, ".config"),
        os.path.join(home, ".cache"),
        os.path.join(home, ".local"),
        os.path.join(home, ".local/share"),
        os.path.join(home, ".local/state"),
    ]
    return {os.path.normpath(p) for p in raw}

PROTECTED_PATHS = get_protected_paths()

def read_app_bundle_id(app_path):
    plist_path = os.path.join(app_path, "Contents", "Info.plist")
    if not os.path.isfile(plist_path):
        return None
    try:
        with open(plist_path, "rb") as f:
            info = plistlib.load(f)
        bid = info.get("CFBundleIdentifier")
        return bid if isinstance(bid, str) and bid else None
    except Exception:
        return None

def find_running_pids(app_name=None, bundle_id=None):
    """
    Finds PIDs of a currently running application by bundle ID and/or .app bundle name
    without launching closed applications or matching unrelated command lines (or zap itself).
    """
    if not app_name and not bundle_id:
        return set()

    excluded = {0, 1, os.getpid(), os.getppid()}
    pids = set()
    app_bundle = None
    if app_name:
        base = os.path.basename(app_name.rstrip("/"))
        app_bundle = base if base.endswith(".app") else f"{base}.app"

    # 1. Query CoreServices LaunchServices via lsappinfo (exact bundleID & bundle path)
    try:
        res = subprocess.run(["lsappinfo", "list"], capture_output=True, text=True, timeout=5)
        if res.returncode == 0:
            for block in re.split(r"\n\s*\n", res.stdout):
                pid_m = re.search(r"\bpid\s*=\s*(\d+)\b", block)
                if not pid_m:
                    continue
                pid = int(pid_m.group(1))
                if pid in excluded:
                    continue
                bid_m = re.search(r'bundleID="([^"]+)"', block)
                bpath_m = re.search(r'bundle path="([^"]+)"', block)
                entry_bid = bid_m.group(1) if bid_m else ""
                entry_bpath = bpath_m.group(1) if bpath_m else ""
                if bundle_id and entry_bid.lower() == bundle_id.lower():
                    pids.add(pid)
                elif app_bundle and entry_bpath and os.path.basename(entry_bpath.rstrip("/")).lower() == app_bundle.lower():
                    pids.add(pid)
    except Exception:
        pass

    # 2. Match helper/child executables running directly inside /<AppName>.app/Contents/
    if app_bundle:
        needle = f"/{app_bundle}/Contents/"
        needle_lower = needle.lower()
        try:
            res = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                for line in res.stdout.splitlines():
                    line = line.strip()
                    if not line:
                        continue
                    parts = line.split(None, 1)
                    if len(parts) != 2 or not parts[0].isdigit():
                        continue
                    pid = int(parts[0])
                    if pid in excluded:
                        continue
                    comm = parts[1]
                    if needle_lower in comm.lower():
                        pids.add(pid)
        except Exception:
            pass

    return pids

def send_signal_to_pids(pids, sig_num):
    for pid in sorted(pids):
        if pid in (0, 1, os.getpid(), os.getppid()):
            continue
        try:
            os.kill(pid, sig_num)
        except ProcessLookupError:
            pass
        except PermissionError:
            run_cmd(["sudo", "kill", f"-{sig_num}", str(pid)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def quit_app(app_name=None, bundle_id=None):
    """
    Safely terminates an application ONLY if it is currently running.
    Never launches closed applications through AppleScript and never uses pkill -f!
    """
    pids = find_running_pids(app_name=app_name, bundle_id=bundle_id)
    if not pids:
        return

    target = bundle_id or app_name
    print(f"🛑 Quitting running application: {target}...")

    if bundle_id:
        try:
            subprocess.run(
                [
                    "osascript",
                    "-e", "on run argv",
                    "-e", "set bid to item 1 of argv",
                    "-e", "if application id bid is running then tell application id bid to quit",
                    "-e", "end run",
                    "--", bundle_id,
                ],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5
            )
        except Exception:
            pass
    elif app_name:
        clean = os.path.basename(app_name.rstrip("/"))
        clean = clean[:-4] if clean.endswith(".app") else clean
        try:
            subprocess.run(
                [
                    "osascript",
                    "-e", "on run argv",
                    "-e", "set appName to item 1 of argv",
                    "-e", "if application appName is running then tell application appName to quit",
                    "-e", "end run",
                    "--", clean,
                ],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5
            )
        except Exception:
            pass

    # Wait briefly for graceful shutdown
    for _ in range(5):
        pids = find_running_pids(app_name=app_name, bundle_id=bundle_id)
        if not pids:
            return
        time.sleep(0.5)

    # Escalate cleanly to SIGTERM then SIGKILL on verified PIDs only
    send_signal_to_pids(pids, signal.SIGTERM)
    time.sleep(0.5)
    pids = find_running_pids(app_name=app_name, bundle_id=bundle_id)
    if pids:
        send_signal_to_pids(pids, signal.SIGKILL)

def handle_signal_step(raw_signals):
    if not raw_signals:
        return
    # Homebrew Cask JSON uses either ["TERM", "com.foo.bar"] or [["TERM", "com.foo.bar"], ...]
    if (
        isinstance(raw_signals, list)
        and len(raw_signals) == 2
        and isinstance(raw_signals[0], str)
        and isinstance(raw_signals[1], str)
    ):
        pairs = [raw_signals]
    else:
        pairs = [s for s in to_list(raw_signals) if isinstance(s, list) and len(s) == 2]

    for sig_name, target in pairs:
        sig_key = str(sig_name).upper()
        if not sig_key.startswith("SIG"):
            sig_key = "SIG" + sig_key
        sig_num = getattr(signal, sig_key, None)
        if sig_num is None:
            continue
        pids = find_running_pids(bundle_id=str(target))
        if pids:
            send_signal_to_pids(pids, sig_num)

def stop_launchctl_service(pattern):
    """
    Stops matching launchctl services in user and system domains without prompting
    for sudo unless a matching system daemon is actually loaded.
    """
    has_wildcard = any(ch in pattern for ch in ("*", "?"))

    # 1. User domain (no sudo required)
    user_matches = []
    if has_wildcard:
        try:
            res = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                for line in res.stdout.splitlines()[1:]:
                    cols = line.split("\t")
                    if len(cols) >= 3 and fnmatch.fnmatch(cols[2].strip(), pattern):
                        user_matches.append(cols[2].strip())
        except Exception:
            pass
    else:
        chk = subprocess.run(["launchctl", "list", pattern], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if chk.returncode == 0:
            user_matches.append(pattern)

    for label in dict.fromkeys(user_matches):
        print(f"🛑 Stopping user service: {label}")
        run_cmd(["launchctl", "remove", label], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)

    # 2. System domain (check without sudo via `launchctl print system/<label>`)
    sys_candidates = []
    if has_wildcard:
        daemons_dir = "/Library/LaunchDaemons"
        if os.path.isdir(daemons_dir):
            try:
                for fname in os.listdir(daemons_dir):
                    if not fname.endswith(".plist"):
                        continue
                    stem = fname[:-6]
                    label = stem
                    fpath = os.path.join(daemons_dir, fname)
                    try:
                        with open(fpath, "rb") as f:
                            pl = plistlib.load(f)
                        if isinstance(pl, dict) and isinstance(pl.get("Label"), str):
                            label = pl["Label"]
                    except Exception:
                        pass
                    if fnmatch.fnmatch(label, pattern) or fnmatch.fnmatch(stem, pattern):
                        sys_candidates.append(label)
            except Exception:
                pass
    else:
        sys_candidates.append(pattern)

    for label in dict.fromkeys(sys_candidates):
        chk = subprocess.run(["launchctl", "print", f"system/{label}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if chk.returncode == 0:
            print(f"🛑 Stopping system service: {label}")
            run_cmd(["sudo", "launchctl", "remove", label], stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)

def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": CLI_USER_AGENT})
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None

def make_formula_zap_data(token):
    return {
        "token": token,
        "artifacts": [
            {"binary": [token]},
            {"zap": [{"trash": [
                f"~/.config/{token}",
                f"~/.cache/{token}",
                f"~/.local/share/{token}",
                f"~/.local/state/{token}"
            ]}]}
        ],
        "variations": {}
    }

def get_zap_data(cask, prefer_cask=False, prefer_formula=False):
    if cask == "newkap":
        return {
            "token": "newkap",
            "artifacts": [
                {"app": ["NewKap.app"]},
                {"zap": [{"quit": "com.wulkano.kap", "trash": [
                    "~/Library/Application Support/NewKap",
                    "~/Library/Application Support/Kap",
                    "~/Library/Preferences/com.wulkano.kap.plist",
                    "~/Library/Caches/com.wulkano.kap",
                    "~/Library/Caches/com.wulkano.kap.ShipIt",
                    "~/Library/Saved Application State/com.wulkano.kap.savedState"
                ]}]}
            ],
            "variations": {}
        }

    # Handle GitHub owner/repo specs (e.g. zap owner/repo)
    if "/" in cask:
        parts = [p for p in cask.split("/") if p]
        if len(parts) == 2:
            repo_token = parts[1].lower()
            if os.path.exists(f"/usr/local/Caskroom/{repo_token}"):
                return make_formula_zap_data(repo_token)
            cask = repo_token

    encoded = urllib.parse.quote(cask, safe="@")

    # 1. Explicit --formula request
    if prefer_formula:
        formula_data = fetch_json(f"https://formulae.brew.sh/api/formula/{encoded}.json")
        if formula_data or os.path.exists(f"/usr/local/Caskroom/{cask}"):
            token = formula_data.get("name", cask) if formula_data else cask
            return make_formula_zap_data(token)
        return None

    # 2. Check Homebrew Cask API
    cask_data = fetch_json(f"https://formulae.brew.sh/api/cask/{encoded}.json")
    if cask_data:
        return cask_data

    # 3. Explicit --cask request: check Cask variants only
    if prefer_cask:
        for suffix in ("-desktop", "-app", "-cli"):
            if not cask.endswith(suffix):
                alt = fetch_json(f"https://formulae.brew.sh/api/cask/{urllib.parse.quote(cask + suffix, safe='@')}.json")
                if alt:
                    print(f"🔄 Resolved '{cask}' -> Cask '{cask}{suffix}'")
                    return alt
        return None

    # 4. Check Homebrew Formula API or locally staged Caskroom entry
    formula_data = fetch_json(f"https://formulae.brew.sh/api/formula/{encoded}.json")
    if formula_data or os.path.exists(f"/usr/local/Caskroom/{cask}"):
        token = formula_data.get("name", cask) if formula_data else cask
        return make_formula_zap_data(token)

    # 5. Check Cask variants (<name>-desktop, <name>-app, <name>-cli)
    for suffix in ("-desktop", "-app", "-cli"):
        if not cask.endswith(suffix):
            alt = fetch_json(f"https://formulae.brew.sh/api/cask/{urllib.parse.quote(cask + suffix, safe='@')}.json")
            if alt:
                print(f"🔄 Resolved '{cask}' -> Cask '{cask}{suffix}'")
                return alt

    return None

def get_intel_artifacts(data):
    variations = data.get("variations") or {}
    supported = data.get("supported_platforms") or []
    host_os = get_host_macos_codename()

    if host_os in variations and isinstance(variations[host_os], dict):
        if "artifacts" in variations[host_os]:
            return list(variations[host_os]["artifacts"])
        return list(data.get("artifacts", []))

    host_in_supported = (host_os in supported) if supported else (host_os in MACOS_ORDER[:7])
    if not host_in_supported:
        idx = MACOS_ORDER.index(host_os) if host_os in MACOS_ORDER else 0
        fallback_keys = MACOS_ORDER[idx + 1:] + list(reversed(MACOS_ORDER[:idx])) + ["x86_64"]
        for os_key in fallback_keys:
            var_entry = variations.get(os_key)
            if isinstance(var_entry, dict) and "artifacts" in var_entry:
                return list(var_entry["artifacts"])

    return list(data.get("artifacts", []))

def resolve_app_paths(artifact):
    paths = []
    if isinstance(artifact.get("target"), str):
        paths.append(expand_cask_path(artifact["target"]))
    for item in to_list(artifact.get("app")):
        if isinstance(item, dict) and isinstance(item.get("target"), str):
            t = expand_cask_path(item["target"])
            if os.path.isabs(t):
                paths.append(t)
            else:
                base = os.path.basename(t)
                paths.append(f"/Applications/{base}")
                paths.append(os.path.expanduser(f"~/Applications/{base}"))
        elif isinstance(item, str):
            base = os.path.basename(item)
            paths.append(f"/Applications/{base}")
            paths.append(os.path.expanduser(f"~/Applications/{base}"))
    return list(dict.fromkeys(os.path.normpath(p) for p in paths if p))

def resolve_binary_target(items):
    raw_target = None
    if len(items) > 1 and isinstance(items[1], dict) and isinstance(items[1].get("target"), str):
        raw_target = items[1]["target"]
    if raw_target:
        expanded = expand_cask_path(raw_target)
        if os.path.isabs(expanded):
            return expanded
        return os.path.join("/usr/local/bin", os.path.basename(expanded))
    return os.path.join("/usr/local/bin", os.path.basename(items[0]))

def resolve_command_wrapper_target(artifact):
    if isinstance(artifact.get("target"), str):
        return expand_cask_path(artifact["target"])
    items = to_list(artifact.get("command_wrapper"))
    if items and isinstance(items[0], str):
        return os.path.join("/usr/local/bin", os.path.basename(items[0]))
    return None

def remove_path(p):
    expanded = expand_cask_path(p)
    matches = glob.glob(expanded)
    if not matches and os.path.lexists(expanded):
        matches = [expanded]
    for m in matches:
        norm_m = os.path.normpath(m)
        if norm_m in PROTECTED_PATHS:
            continue
        print(f"🗑️  Removing: {norm_m}")
        try:
            if os.path.isdir(norm_m) and not os.path.islink(norm_m):
                shutil.rmtree(norm_m)
            else:
                os.remove(norm_m)
        except PermissionError:
            run_cmd(["sudo", "rm", "-rf", norm_m])
        except Exception as e:
            print(f"⚠️  Could not remove {norm_m}: {e}")

def remove_caskroom_symlinks(cask):
    cask_dir = f"/usr/local/Caskroom/{cask}"
    bin_dir = "/usr/local/bin"
    if not os.path.isdir(bin_dir):
        return
    for entry in os.listdir(bin_dir):
        full_link = os.path.join(bin_dir, entry)
        if os.path.islink(full_link):
            try:
                target = os.readlink(full_link)
                resolved = os.path.abspath(os.path.join(bin_dir, target))
                if resolved == cask_dir or resolved.startswith(cask_dir + "/"):
                    remove_path(full_link)
            except Exception:
                pass

def zap_cask(cask_arg, prefer_cask=False, prefer_formula=False):
    data = get_zap_data(cask_arg, prefer_cask=prefer_cask, prefer_formula=prefer_formula)
    if not data:
        print(f"❌ Could not find '{cask_arg}' in the Cask or Formula database.")
        return False

    cask = data.get("token", cask_arg)
    print(f"⚡ Zapping '{cask}'...")
    artifacts = get_intel_artifacts(data)

    # Pass 1: Gracefully quit applications and stop launchctl daemons/services before deleting
    for artifact in artifacts:
        if not isinstance(artifact, dict):
            continue

        if "app" in artifact:
            for app_path in resolve_app_paths(artifact):
                bid = read_app_bundle_id(app_path) if os.path.isdir(app_path) else None
                quit_app(app_name=os.path.basename(app_path), bundle_id=bid)

        for stage in ("uninstall", "zap"):
            if stage in artifact:
                for step in to_list(artifact[stage]):
                    if not isinstance(step, dict):
                        continue
                    for q in to_list(step.get("quit", [])):
                        if isinstance(q, str):
                            quit_app(bundle_id=q)
                    handle_signal_step(step.get("signal"))
                    for lc in to_list(step.get("launchctl", [])):
                        if isinstance(lc, str):
                            stop_launchctl_service(lc)

    # Pass 2: Remove app bundles, binaries, wrappers, receipts, and files
    rmdir_candidates = []
    for artifact in artifacts:
        if not isinstance(artifact, dict):
            continue

        if "app" in artifact:
            for app_path in resolve_app_paths(artifact):
                remove_path(app_path)

        if "binary" in artifact:
            items = to_list(artifact["binary"])
            if items and isinstance(items[0], str):
                remove_path(resolve_binary_target(items))

        if "command_wrapper" in artifact:
            wrapper_target = resolve_command_wrapper_target(artifact)
            if wrapper_target:
                remove_path(wrapper_target)

        for stage in ("uninstall", "zap"):
            if stage in artifact:
                for step in to_list(artifact[stage]):
                    if not isinstance(step, dict):
                        continue
                    for key in ("trash", "delete"):
                        for p in to_list(step.get(key, [])):
                            if isinstance(p, str):
                                remove_path(p)
                    for pkg in to_list(step.get("pkgutil", [])):
                        if isinstance(pkg, str):
                            res = subprocess.run(["pkgutil", "--pkgs=" + pkg], capture_output=True, text=True)
                            matched_pkgs = [line.strip() for line in res.stdout.splitlines() if line.strip()]
                            if not matched_pkgs and not any(c in pkg for c in "*?[^$\\"):
                                info_res = subprocess.run(["pkgutil", "--pkg-info", pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                if info_res.returncode == 0:
                                    matched_pkgs = [pkg]
                            for mp in matched_pkgs:
                                print(f"📦 Forgetting package receipt: {mp}")
                                run_cmd(["sudo", "pkgutil", "--forget", mp], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    for rd in to_list(step.get("rmdir", [])):
                        if isinstance(rd, str):
                            rmdir_candidates.append(rd)

    remove_caskroom_symlinks(cask)
    remove_path(f"/usr/local/Caskroom/{cask}")

    # Pass 3: Remove now-empty directories requested by rmdir
    for rd in dict.fromkeys(rmdir_candidates):
        expanded = expand_cask_path(rd)
        matches = glob.glob(expanded) or ([expanded] if os.path.isdir(expanded) else [])
        for m in matches:
            norm_m = os.path.normpath(m)
            if norm_m in PROTECTED_PATHS:
                continue
            try:
                if os.path.isdir(norm_m) and not os.path.islink(norm_m) and not os.listdir(norm_m):
                    remove_path(norm_m)
            except OSError:
                pass

    tracker = os.path.expanduser("~/.installed_casks.txt")
    if os.path.exists(tracker):
        with open(tracker, "r") as f:
            lines = []
            for line in f:
                entry = line.strip()
                if not entry:
                    continue
                if entry in (cask, cask_arg):
                    continue
                if "/" in entry and entry.split("/")[-1].lower() == cask.lower():
                    continue
                lines.append(entry)
        with open(tracker, "w") as f:
            f.write("\n".join(lines) + ("\n" if lines else ""))

    print(f"✅ Successfully zapped '{cask}'!\n")
    return True

def print_usage():
    print("Usage: zap [--cask | --formula] <app-or-formula-name> [app2 ...]")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_usage()
        sys.exit(0 if len(sys.argv) >= 2 else 1)

    prefer_cask = False
    prefer_formula = False
    targets = []
    for arg in sys.argv[1:]:
        if arg in ("--cask", "--casks"):
            prefer_cask = True
        elif arg in ("--formula", "--formulae"):
            prefer_formula = True
        elif arg in ("--zap", "--force", "-f"):
            continue
        else:
            targets.append(arg)

    if not targets:
        print("❌ Please specify at least one package to zap.")
        print_usage()
        sys.exit(1)

    success_all = True
    for cask in targets:
        if not zap_cask(cask, prefer_cask=prefer_cask, prefer_formula=prefer_formula):
            success_all = False
    sys.exit(0 if success_all else 1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n🛑 Operation cancelled by user.")
        sys.exit(130)
